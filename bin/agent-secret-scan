#!/bin/bash
#
# agent-secret-scan - keep literal credentials out of what AI agents send to their model.
#
# Hook command shared by Claude Code (managed settings) and Codex (requirements.toml).
#
#   agent-secret-scan           Block mode: every Codex hook, and Claude Code's UserPromptSubmit
#                               and PreToolUse. Exit 0 allows the event; exit 2 blocks it, with a
#                               one-line reason on stderr. On Codex's PostToolUse, exit 2 replaces
#                               the tool result with that reason.
#   agent-secret-scan --redact  Redact mode: Claude Code's PostToolUse. Prints nothing when the
#                               tool result is clean; otherwise prints the hook output that
#                               replaces each credential in the result with [REDACTED].
#
#   Input:  one hook event as JSON on stdin.
#   Failure: block mode exits 2, so a broken scanner blocks instead of allowing: Codex treats
#           any other code as "allow". Redact mode prints {"continue": false}: the tool has
#           already run, and stopping the session keeps its result from the model.
#
# Detection is delegated to gitleaks and its maintained default rules. This script only
# prepares the input and pins the configuration; it reads nothing from the environment, which
# a project can influence, and calls no program through PATH.

set -uo pipefail

mode=block
[[ ${1:-} == --redact ]] && mode=redact

# fail REASON: the scanner could not do its job, so nothing passes.
fail() {
  if [[ $mode == redact ]]; then
    printf '{"continue":false,"stopReason":"agent-secret-scan: %s The session was stopped so that this tool result does not reach the model."}\n' "$1"
    exit 0
  fi
  echo "agent-secret-scan: $1 The action is blocked." >&2
  exit 2
}

# Everything lives next to this script: <root>/bin/agent-secret-scan, <root>/bin/gitleaks and
# <root>/etc/gitleaks.toml. Parameter expansion instead of dirname: no PATH lookup.
here=${BASH_SOURCE[0]%/*}
root=$(cd "$here/.." && pwd -P) || fail "cannot locate itself."

# gitleaks reads .gitleaksignore from its working directory. The agent's directory is an
# untrusted repository, so run from the root-owned configuration directory instead.
cd "$root/etc" || fail "cannot enter $root/etc."

# decode FILTER: hook events are JSON, where quotes inside values are escaped (\"), but gitleaks
# rules expect raw text. Print every string value under FILTER, decoded. Fails on empty or
# malformed input and on anything that is not a JSON object.
decode() { /usr/bin/env -i /usr/bin/jq -rn "input | if type == \"object\" then $1 | .. | strings else error(\"not an object\") end"; }

# scan OPTIONS...: gitleaks over stdin, with the pinned configuration. `env -i`: an empty
# environment, so GITLEAKS_* variables have no effect.
scan() { /usr/bin/env -i "$root/bin/gitleaks" stdin --config "$root/etc/gitleaks.toml" --ignore-gitleaks-allow --no-banner --log-level error "$@"; }

# Read the inherited descriptor directly. Claude Code can provide a socket as stdin,
# and reopening /dev/stdin fails with ENXIO on Linux for that transport.
# Duplicate it first so a closed stdin fails before command substitution can reuse fd 0.
exec 3<&0 || fail "cannot read the hook event."
event=$(/bin/cat <&3) || fail "cannot read the hook event."
exec 3<&-

if [[ $mode == block ]]; then
  printf '%s' "$event" | decode . | scan --redact --exit-code 2
  status=("${PIPESTATUS[@]}")
  (( status[1] == 0 )) || fail "the hook event is empty or malformed."
  case ${status[2]} in
    0) exit 0 ;;
    2) ;;
    *) fail "gitleaks failed with exit code ${status[2]}." ;;
  esac
  if [[ $(printf '%s' "$event" | /usr/bin/env -i /usr/bin/jq -r '.hook_event_name // empty') == PostToolUse ]]; then
    echo "agent-secret-scan: the tool result contains a literal credential and was withheld." >&2
  else
    echo "agent-secret-scan: a literal credential was detected. Reference it through an environment variable or a secret manager instead." >&2
  fi
  exit 2
fi

# Redact mode. Find the credentials in the tool result, then replace each one literally in every
# string of the result. Only string values change, so the result keeps the shape Claude Code
# requires of `updatedToolOutput`. The credentials reach jq on stdin, never as arguments.
report=$(printf '%s' "$event" | decode .tool_response | scan --report-format json --report-path - --exit-code 0) ||
  fail "could not scan this tool result."
output=$(printf '%s\n%s\n' "$event" "$report" | /usr/bin/env -i /usr/bin/jq -cn '
  input as $event
  | [input[].Secret | select(length > 0)] | unique | sort_by(-length) as $secrets
  | if $secrets == [] then empty else {hookSpecificOutput: {
      hookEventName: "PostToolUse",
      updatedToolOutput: ($event.tool_response | walk(if type == "string" then reduce $secrets[] as $s (.; split($s) | join("[REDACTED]")) else . end)),
      additionalContext: "agent-secret-scan: \($secrets | length) literal credential(s) in this tool result were replaced with [REDACTED]."
    }} end') || fail "could not redact this tool result."
[[ -n $output ]] || exit 0

# A credential split across two string values would survive the replacement: scan once more.
printf '%s' "$output" | decode .hookSpecificOutput.updatedToolOutput | scan --redact --exit-code 2 >/dev/null ||
  fail "a credential remained after redaction."
printf '%s\n' "$output"
