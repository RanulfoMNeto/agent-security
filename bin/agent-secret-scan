#!/bin/bash
#
# agent-secret-scan - block AI agent prompts and tool calls that contain literal credentials.
#
# Hook command shared by Claude Code (managed settings) and Codex (requirements.toml).
#
#   Input:  one hook event as JSON on stdin (UserPromptSubmit or PreToolUse).
#   Output: nothing when the event is allowed; a one-line reason on stderr when blocked.
#   Exit:   0 allows the action, 2 blocks it. Every failure also exits 2, so a broken
#           scanner blocks instead of allowing: Codex treats any other code as "allow".
#
# Detection is delegated to gitleaks and its maintained default rules. This script only
# prepares the input and pins the configuration; it reads nothing from the environment, which
# a project can influence, and calls no program through PATH.

set -uo pipefail

# Everything lives next to this script: <root>/bin/agent-secret-scan, <root>/bin/gitleaks and
# <root>/etc/gitleaks.toml. Parameter expansion instead of dirname: no PATH lookup.
here=${BASH_SOURCE[0]%/*}
root=$(cd "$here/.." && pwd -P) || { echo "agent-secret-scan: cannot locate itself; the action is blocked." >&2; exit 2; }

# gitleaks reads .gitleaksignore from its working directory. The agent's directory is an
# untrusted repository, so run from the root-owned configuration directory instead.
cd "$root/etc" || { echo "agent-secret-scan: cannot enter $root/etc; the action is blocked." >&2; exit 2; }

# `env -i`: an empty environment, so GITLEAKS_* variables have no effect.
#
# Hook events are JSON, where quotes inside values are escaped (\"), but gitleaks rules
# expect raw text. jq decodes every string value, and fails on empty or malformed input and
# on anything that is not a JSON object.
/usr/bin/env -i /usr/bin/jq -rn 'input | if type == "object" then .. | strings else error("not an object") end' |
  /usr/bin/env -i "$root/bin/gitleaks" stdin \
    --config "$root/etc/gitleaks.toml" \
    --ignore-gitleaks-allow \
    --no-banner \
    --redact \
    --log-level error \
    --exit-code 2
status=("${PIPESTATUS[@]}")

if (( status[0] != 0 )); then
  echo "agent-secret-scan: the hook event is empty or malformed; the action is blocked." >&2
  exit 2
fi

case "${status[1]}" in
  0) exit 0 ;;
  2) echo "agent-secret-scan: a literal credential was detected. Reference it through an environment variable or a secret manager instead." >&2 ;;
  *) echo "agent-secret-scan: gitleaks failed with exit code ${status[1]}; the action is blocked." >&2 ;;
esac
exit 2
