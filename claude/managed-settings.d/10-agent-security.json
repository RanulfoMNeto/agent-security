{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.password-store/**)",
      "Read(~/.config/op/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.local/share/keyrings/**)",
      "Read(~/.mozilla/**)",
      "Read(~/.config/google-chrome/**)",
      "Read(~/.config/chromium/**)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Application Support/Google/Chrome/**)",
      "Read(~/Library/Application Support/Firefox/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.config/git/credentials)",
      "Read(~/.cache/git/credential/**)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.vault-token)",
      "Read(~/.terraform.d/credentials.tfrc.json)",
      "Read(~/.bash_history)",
      "Read(~/.zsh_history)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.profile)",
      "Edit(~/.zshrc)",
      "Edit(~/.zprofile)",
      "Edit(~/.zshenv)",
      "Edit(~/.gitconfig)",
      "Edit(~/.config/git/config)",
      "Edit(~/.ssh/**)",
      "Edit(~/.config/autostart/**)",
      "Edit(~/Library/LaunchAgents/**)",
      "Bash(rm -r *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -R *)",
      "Bash(rm --recursive *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "enableWeakerNestedSandbox": false,
    "allowNestedUserNamespaces": false,
    "filesystem": {
      "allowManagedReadPathsOnly": true
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "gitlab.com",
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "repo.yarnpkg.com",
        "pypi.org",
        "files.pythonhosted.org",
        "crates.io",
        "index.crates.io",
        "static.crates.io",
        "static.rust-lang.org",
        "proxy.golang.org",
        "sum.golang.org",
        "rubygems.org",
        "index.rubygems.org",
        "repo.maven.apache.org",
        "repo1.maven.org",
        "plugins.gradle.org",
        "services.gradle.org",
        "downloads.gradle.org",
        "api.nuget.org",
        "repo.packagist.org"
      ]
    },
    "credentials": {
      "files": [
        { "path": "**/.env", "mode": "deny" },
        { "path": "**/.env.*", "mode": "deny" }
      ],
      "envVars": [
        { "name": "ANTHROPIC_API_KEY", "mode": "deny" },
        { "name": "OPENAI_API_KEY", "mode": "deny" },
        { "name": "GEMINI_API_KEY", "mode": "deny" },
        { "name": "GOOGLE_API_KEY", "mode": "deny" },
        { "name": "HF_TOKEN", "mode": "deny" },
        { "name": "HUGGING_FACE_HUB_TOKEN", "mode": "deny" },
        { "name": "AZURE_OPENAI_API_KEY", "mode": "deny" },
        { "name": "MISTRAL_API_KEY", "mode": "deny" },
        { "name": "GROQ_API_KEY", "mode": "deny" },
        { "name": "DEEPSEEK_API_KEY", "mode": "deny" },
        { "name": "OPENROUTER_API_KEY", "mode": "deny" },
        { "name": "COHERE_API_KEY", "mode": "deny" },
        { "name": "XAI_API_KEY", "mode": "deny" },
        { "name": "TOGETHER_API_KEY", "mode": "deny" },
        { "name": "REPLICATE_API_TOKEN", "mode": "deny" },
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "GH_ENTERPRISE_TOKEN", "mode": "deny" },
        { "name": "GITHUB_ENTERPRISE_TOKEN", "mode": "deny" },
        { "name": "GITLAB_TOKEN", "mode": "deny" },
        { "name": "AWS_ACCESS_KEY_ID", "mode": "deny" },
        { "name": "AWS_SECRET_ACCESS_KEY", "mode": "deny" },
        { "name": "AWS_SESSION_TOKEN", "mode": "deny" },
        { "name": "AZURE_CLIENT_SECRET", "mode": "deny" },
        { "name": "GOOGLE_APPLICATION_CREDENTIALS", "mode": "deny" },
        { "name": "ARM_CLIENT_SECRET", "mode": "deny" },
        { "name": "CLOUDFLARE_API_TOKEN", "mode": "deny" },
        { "name": "DIGITALOCEAN_ACCESS_TOKEN", "mode": "deny" },
        { "name": "HCLOUD_TOKEN", "mode": "deny" },
        { "name": "VERCEL_TOKEN", "mode": "deny" },
        { "name": "NETLIFY_AUTH_TOKEN", "mode": "deny" },
        { "name": "HEROKU_API_KEY", "mode": "deny" },
        { "name": "FLY_API_TOKEN", "mode": "deny" },
        { "name": "VAULT_TOKEN", "mode": "deny" },
        { "name": "TF_TOKEN_app_terraform_io", "mode": "deny" },
        { "name": "NPM_TOKEN", "mode": "deny" },
        { "name": "NODE_AUTH_TOKEN", "mode": "deny" },
        { "name": "YARN_NPM_AUTH_TOKEN", "mode": "deny" },
        { "name": "TWINE_PASSWORD", "mode": "deny" },
        { "name": "UV_PUBLISH_TOKEN", "mode": "deny" },
        { "name": "POETRY_PYPI_TOKEN_PYPI", "mode": "deny" },
        { "name": "CARGO_REGISTRY_TOKEN", "mode": "deny" },
        { "name": "GEM_HOST_API_KEY", "mode": "deny" },
        { "name": "DOCKERHUB_TOKEN", "mode": "deny" },
        { "name": "CI_JOB_TOKEN", "mode": "deny" },
        { "name": "CODECOV_TOKEN", "mode": "deny" },
        { "name": "SONAR_TOKEN", "mode": "deny" },
        { "name": "SNYK_TOKEN", "mode": "deny" },
        { "name": "SLACK_BOT_TOKEN", "mode": "deny" },
        { "name": "SLACK_TOKEN", "mode": "deny" },
        { "name": "SLACK_WEBHOOK_URL", "mode": "deny" },
        { "name": "SENTRY_AUTH_TOKEN", "mode": "deny" },
        { "name": "STRIPE_SECRET_KEY", "mode": "deny" },
        { "name": "STRIPE_API_KEY", "mode": "deny" },
        { "name": "TWILIO_AUTH_TOKEN", "mode": "deny" },
        { "name": "SENDGRID_API_KEY", "mode": "deny" },
        { "name": "OP_SERVICE_ACCOUNT_TOKEN", "mode": "deny" },
        { "name": "BW_SESSION", "mode": "deny" },
        { "name": "SSH_AUTH_SOCK", "mode": "deny" }
      ]
    }
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/agent-security/bin/agent-secret-scan",
            "args": [],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/agent-security/bin/agent-secret-scan",
            "args": [],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/agent-security/bin/agent-secret-scan",
            "args": ["--redact"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
