#!/bin/bash
#
# agent-secret-scan - block AI agent prompts and tool calls that contain literal credentials.
#
# Hook command shared by Claude Code (managed settings) and Codex (config.toml).
#
#   Input:  one hook event as JSON on stdin (UserPromptSubmit or PreToolUse).
#   Output: nothing when the event is allowed; a one-line reason on stderr when blocked.
#   Exit:   0 allows the action, 2 blocks it. Every failure also exits 2, so a broken
#           scanner blocks instead of allowing: Codex treats any other code as "allow".
#
# Detection is delegated to gitleaks and its maintained default rules; this script only
# prepares the input and pins the configuration. See README.md for the design.

set -uo pipefail

readonly CONFIG_DIR=/etc/agent-security
readonly GITLEAKS=/usr/local/bin/gitleaks
readonly JQ=/usr/bin/jq

block() {
  printf 'agent-secret-scan: %s\n' "$1" >&2
  exit 2
}

# gitleaks reads .gitleaksignore from its working directory. The agent's working directory
# is an untrusted repository, so run from the root-owned configuration directory instead.
cd "$CONFIG_DIR" || block "cannot enter $CONFIG_DIR; the action is blocked."

# Hook events are JSON, where quotes inside values are escaped (\"). gitleaks rules expect
# raw text, so pass every string value decoded, one after another.
"$JQ" -r '.. | strings' |
  "$GITLEAKS" stdin \
    --config "$CONFIG_DIR/gitleaks.toml" \
    --gitleaks-ignore-path "$CONFIG_DIR" \
    --ignore-gitleaks-allow \
    --no-banner \
    --redact \
    --log-level error \
    --exit-code 2
status=("${PIPESTATUS[@]}")

if (( status[0] != 0 )); then
  block "the hook event is not valid JSON; the action is blocked."
fi

case "${status[1]}" in
  0) exit 0 ;;
  2) block "a literal credential was detected. Reference it through an environment variable or a secret manager instead." ;;
  *) block "gitleaks failed with exit code ${status[1]}; the action is blocked." ;;
esac
